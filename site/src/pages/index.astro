---
// Portada del laboratorio: una entrada por experimento.
const experiments = [
  {
    href: '/voronoi',
    title: 'Voronoi',
    blurb: 'Celdas a la deriva en un campo de flujo. El cursor es una celda más.',
  },
];
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>math.adamdub.xyz — laboratorio</title>
  <meta name="description" content="Laboratorio de experimentos visuales y matemáticos." />
</head>
<body>
  <main>
    <h1>laboratorio</h1>
    <p class="lede">Experimentos visuales y matemáticos para mirar y tocar.</p>
    <ul>
      {experiments.map((x, i) => (
        <li>
          <a href={x.href}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{x.title}</span>
            <span class="blurb">{x.blurb}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <style is:global>
    html, body { margin: 0; background: #03060c; color: #cfe7f2; }
    body { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
    main { max-width: 720px; margin: 0 auto; padding: 12vh 24px; }
    h1 { font-size: 14px; letter-spacing: 0.4em; text-transform: uppercase; margin: 0 0 8px; }
    .lede { opacity: 0.7; margin: 0 0 48px; }
    ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(170, 235, 255, 0.2); }
    li { border-bottom: 1px solid rgba(170, 235, 255, 0.2); }
    a {
      display: grid;
      grid-template-columns: 3ch 1fr;
      gap: 4px 16px;
      padding: 20px 0;
      color: inherit;
      text-decoration: none;
    }
    a:hover .name, a:focus-visible .name { color: #fff; text-shadow: 0 0 12px rgba(170, 235, 255, 0.6); }
    .num { opacity: 0.5; }
    .name { font-size: 22px; }
    .blurb { grid-column: 2; opacity: 0.65; font-size: 14px; }
  </style>
</body>
</html>
